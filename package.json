{
  "name": "unios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:export": "tsx scripts/db.ts export",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "telegram:webhook": "tsx --env-file-if-exists=.env.local scripts/telegram-webhook.ts",
    "telegram:setup": "tsx --env-file-if-exists=.env.local scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
