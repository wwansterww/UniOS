# ---------- UniOS environment ----------
# Nothing here is required to run the demo locally: without DATABASE_URL the app uses a
# built-in Postgres (PGlite) in .data/ and seeds demo data automatically.

# Public URL of the app (used in Telegram buttons, magic links, .ics links)
APP_URL=http://localhost:3000

# Demo mode: "Войти как студент/преподаватель" buttons, any email allowed. Set to false in production.
DEMO_MODE=true
# Only this email domain may sign up when DEMO_MODE=false
ALLOWED_EMAIL_DOMAIN=narxoz.kz
# Secret code that turns a sign-up into a teacher account
TEACHER_CODE=change-me-teacher-code
# Random 32+ chars, signs session cookies:  openssl rand -base64 32
AUTH_SECRET=

# Supabase Postgres (Project → Settings → Database → Connection string → Transaction pooler, port 6543)
# Server-side only — never expose it to the browser.
DATABASE_URL=
# Seed demo data into an empty database (true/false)
SEED_DEMO=true

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling = local dev (no public URL needed), webhook = production (run npm run telegram:webhook)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# Scheduler endpoint secret (pg_cron sends it as "Authorization: Bearer ...")
CRON_SECRET=
# Local in-process scheduler (ticks every minute on npm run dev/start). "off" to disable.
SCHEDULER=on

# Email fallback via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=UniOS <onboarding@resend.dev>

# Official course registration site (button on the Registration screen)
REGISTRATION_URL=https://narxoz.kz
